# ─────────────────────────────────────────────────────────────
#  ParkEase environment variables (Expo SDK 54 — process.env)
#  Every variable MUST start with EXPO_PUBLIC_ to be exposed to the app.
#  These values get bundled into the app, so ONLY put public-safe
#  values here. NEVER put secret keys (Khalti secret, Supabase
#  service_role) in this file.
#
#  After editing this file, ALWAYS restart with cache cleared:
#      npx expo start -c
# ─────────────────────────────────────────────────────────────

# ── Supabase (anon key + URL are public; protected by RLS) ──
EXPO_PUBLIC_SUPABASE_URL=https://yyhytueronsovjifusjc.supabase.co
